<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FantoApp.MainPage"
             BackgroundColor="#0A0A0A">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="TuiTextStyle">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextColor" Value="#C8C8C8" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style TargetType="Label" x:Key="LinkTextStyle">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextColor" Value="#6E6E6E" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid VerticalOptions="Center" HorizontalOptions="Fill" Padding="16">

            <Border x:Name="RootBorder"
                    Stroke="#3A3A3A"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    BackgroundColor="#0A0A0A"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="600"
                    Padding="16">

            <Grid>

                <!--  Start screen  -->
                <VerticalStackLayout x:Name="StartPanel" Spacing="6" IsVisible="True">

                    <Grid HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label x:Name="TitleShadowLabel"
                               Text="TIME CTRL"
                               FontFamily="Consolas"
                               FontAttributes="Bold"
                               FontSize="52"
                               CharacterSpacing="4"
                               TextColor="#0B3D22"
                               TranslationX="4"
                               TranslationY="4"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />
                        <Label x:Name="TitleForegroundLabel"
                               Text="TIME CTRL"
                               FontFamily="Consolas"
                               FontAttributes="Bold"
                               FontSize="52"
                               CharacterSpacing="4"
                               TextColor="#00E676"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation">
                            <Label.Shadow>
                                <Shadow Brush="#00E676" Offset="0,0" Radius="14" Opacity="0.55" />
                            </Label.Shadow>
                        </Label>
                    </Grid>

                    <Label Text="Terminal-native work hours calculator"
                           FontFamily="Consolas"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#4EA1F3"
                           HorizontalOptions="Center"
                           Margin="0,4,0,0" />

                    <Label Text="Calculate your exit time in a TUI-style console"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextColor="#8A8A8A"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#3A3A3A" HorizontalOptions="Fill" Margin="0,18,0,10" />

                    <HorizontalStackLayout Spacing="10" Margin="10,10,0,0">
                        <Label Text="&gt;" FontFamily="Consolas" FontAttributes="Bold" FontSize="18" TextColor="#E0A25A" />
                        <Label Text="Start Time Entry" FontFamily="Consolas" FontAttributes="Bold" FontSize="18" TextColor="#00E676" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartTapped" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#3A3A3A" HorizontalOptions="Fill" Margin="0,18,0,10" />

                    <Label Text="enter / tap: confirm   ctrl+c: quit"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextColor="#6E6E6E" />
                </VerticalStackLayout>

                <!--  Entry screen  -->
                <VerticalStackLayout x:Name="EntryPanel" Spacing="14" IsVisible="False">

                    <Label Text="Work Hours Calculator"
                           FontFamily="Consolas"
                           FontAttributes="Bold"
                           FontSize="22"
                           TextColor="#4EA1F3" />

                    <BoxView HeightRequest="1" Color="#3A3A3A" HorizontalOptions="Fill" />

                    <Label Text="Enter your start time (4 digits, e.g. 0800):"
                           Style="{StaticResource TuiTextStyle}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="&gt;"
                               Style="{StaticResource TuiTextStyle}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               x:Name="StartTimeEntry"
                               Placeholder="0800"
                               PlaceholderColor="#6E6E6E"
                               TextColor="#EDEDED"
                               FontFamily="Consolas"
                               FontSize="18"
                               HorizontalOptions="Fill"
                               Keyboard="Numeric"
                               MaxLength="4"
                               Completed="OnStartTimeEntryCompleted" />
                    </Grid>

                    <Label x:Name="ErrorLabel"
                           Text="Invalid time. Enter 4 digits (0000 - 2359)."
                           TextColor="#E05A5A"
                           FontFamily="Consolas"
                           FontSize="14"
                           IsVisible="False" />

                    <BoxView HeightRequest="1" Color="#3A3A3A" HorizontalOptions="Fill" Margin="0,10,0,0" />

                    <Label Text="&lt; Back to menu"
                           Style="{StaticResource LinkTextStyle}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToStartTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Enter: calculate   Esc: back"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextColor="#6E6E6E" />
                </VerticalStackLayout>

                <!--  Result screen  -->
                <VerticalStackLayout x:Name="ResultPanel" Spacing="14" IsVisible="False">

                    <Label Text="Work Hours Calculator"
                           FontFamily="Consolas"
                           FontAttributes="Bold"
                           FontSize="22"
                           TextColor="#4EA1F3" />

                    <BoxView HeightRequest="1" Color="#3A3A3A" HorizontalOptions="Fill" />

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="6"
                          ColumnSpacing="16">

                        <Label Grid.Row="0" Grid.Column="0" Text="Entry:" Style="{StaticResource TuiTextStyle}" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="EntryValueLabel" Style="{StaticResource TuiTextStyle}" TextColor="#EDEDED" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Coffee break:" Style="{StaticResource TuiTextStyle}" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="CoffeeBreakValueLabel" Style="{StaticResource TuiTextStyle}" TextColor="#EDEDED" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Lunch start:" Style="{StaticResource TuiTextStyle}" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="LunchStartValueLabel" Style="{StaticResource TuiTextStyle}" TextColor="#EDEDED" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Lunch end:" Style="{StaticResource TuiTextStyle}" />
                        <Label Grid.Row="3" Grid.Column="1" x:Name="LunchEndValueLabel" Style="{StaticResource TuiTextStyle}" TextColor="#EDEDED" />

                        <BoxView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="1" Color="#2A2A2A" Margin="0,8" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Normal exit:" Style="{StaticResource TuiTextStyle}" />
                        <Label Grid.Row="5" Grid.Column="1" x:Name="NormalExitValueLabel" Style="{StaticResource TuiTextStyle}" TextColor="#7FD97F" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Maximum exit:" Style="{StaticResource TuiTextStyle}" />
                        <Label Grid.Row="6" Grid.Column="1" x:Name="MaximumExitValueLabel" Style="{StaticResource TuiTextStyle}" TextColor="#E0A25A" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#3A3A3A" HorizontalOptions="Fill" Margin="0,10,0,0" />

                    <HorizontalStackLayout Spacing="24">
                        <Label Text="&lt; New calculation" Style="{StaticResource LinkTextStyle}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToConsoleTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="&lt; Back to menu" Style="{StaticResource LinkTextStyle}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToStartTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Label Text="Enter: back to console   Esc: back"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextColor="#6E6E6E" />
                </VerticalStackLayout>

            </Grid>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
